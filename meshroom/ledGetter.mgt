{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.1",
        "nodesVersions": {
            "CameraInit": "12.1",
            "DepthMap": "5.1",
            "DepthMapFilter": "4.0",
            "ExportImages": "1.1",
            "FeatureExtraction": "1.3",
            "FeatureMatching": "2.1",
            "ImageMatching": "2.1",
            "ImageProcessing": "4.1",
            "ImageSegmentationSam3": "2.0",
            "IntrinsicsTransforming": "1.1",
            "LedGetterLights": "1.0",
            "LedGetterPS": "1.0",
            "MeshFiltering": "3.0",
            "Meshing": "7.0",
            "SfMFilter": "2.0",
            "SfMTransfer": "2.2",
            "StructureFromMotion": "3.3"
        },
        "template": true
    },
    "graph": {
        "CameraInit_1": {
            "nodeType": "CameraInit",
            "position": [
                0,
                0
            ],
            "inputs": {}
        },
        "DepthMapFilter_1": {
            "nodeType": "DepthMapFilter",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{DepthMap_1.input}",
                "depthMapsFolder": "{DepthMap_1.output}"
            }
        },
        "DepthMap_1": {
            "nodeType": "DepthMap",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{IntrinsicsTransforming_1.output}",
                "imagesFolder": "{ExportImages_1.output}"
            }
        },
        "ExportImages_1": {
            "nodeType": "ExportImages",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{IntrinsicsTransforming_1.input}",
                "target": "{IntrinsicsTransforming_1.output}",
                "masksFolders": [
                    "{ImageSegmentationSam3_1.output}"
                ],
                "outputFileType": "png"
            }
        },
        "ExportImages_2": {
            "nodeType": "ExportImages",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{IntrinsicsTransforming_2.input}",
                "target": "{IntrinsicsTransforming_2.output}",
                "masksFolders": [
                    "{ImageSegmentationSam3_1.output}"
                ]
            }
        },
        "FeatureExtraction_1": {
            "nodeType": "FeatureExtraction",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "masksFolder": "{ImageSegmentationSam3_1.output}"
            }
        },
        "FeatureExtraction_2": {
            "nodeType": "FeatureExtraction",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "describerTypes": [
                    "tag16h5"
                ]
            }
        },
        "FeatureMatching_1": {
            "nodeType": "FeatureMatching",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageMatching_1.input}",
                "featuresFolders": "{ImageMatching_1.featuresFolders}",
                "imagePairsList": "{ImageMatching_1.output}",
                "describerTypes": [
                    "dspsift",
                    "tag16h5"
                ]
            }
        },
        "ImageMatching_1": {
            "nodeType": "ImageMatching",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "featuresFolders": [
                    "{FeatureExtraction_1.output}",
                    "{FeatureExtraction_2.output}"
                ]
            }
        },
        "ImageProcessing_1": {
            "nodeType": "ImageProcessing",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{CameraInit_1.output}",
                "extension": "exr"
            }
        },
        "ImageSegmentationSam3_1": {
            "nodeType": "ImageSegmentationSam3",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{ImageProcessing_1.outSfMData}",
                "prompt": "stone",
                "extensionOut": "png"
            }
        },
        "IntrinsicsTransforming_1": {
            "nodeType": "IntrinsicsTransforming",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{SfMTransfer_1.output}"
            }
        },
        "IntrinsicsTransforming_2": {
            "nodeType": "IntrinsicsTransforming",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{SfMTransfer_2.output}"
            }
        },
        "LedGetterLights_1": {
            "nodeType": "LedGetterLights",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputSfm": "{ExportImages_2.outputSfMData}",
                "inputMesh": "{MeshFiltering_1.outputMesh}",
                "lightRig": true
            }
        },
        "LedGetterPS_1": {
            "nodeType": "LedGetterPS",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputSfm": "{ExportImages_2.outputSfMData}",
                "inputMesh": "{MeshFiltering_1.outputMesh}",
                "inputLights": "{LedGetterLights_1.outputFolder}"
            }
        },
        "MeshFiltering_1": {
            "nodeType": "MeshFiltering",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputMesh": "{Meshing_1.outputMesh}"
            }
        },
        "Meshing_1": {
            "nodeType": "Meshing",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{DepthMapFilter_1.input}",
                "depthMapsFolder": "{DepthMapFilter_1.output}"
            }
        },
        "SfMFilter_1": {
            "nodeType": "SfMFilter",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputFile": "{CameraInit_1.output}",
                "expression": "contains(path, \"/MV/\")"
            }
        },
        "SfMFilter_2": {
            "nodeType": "SfMFilter",
            "position": [
                0,
                0
            ],
            "inputs": {
                "inputFile": "{CameraInit_1.output}",
                "expression": "contains(path, \"/PS/\") and match(path, \"(?i)(all_leds|ambient)|/LIGHT\\.\") == False"
            }
        },
        "SfMTransfer_1": {
            "nodeType": "SfMTransfer",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{SfMFilter_1.outputSfMData_selected}",
                "reference": "{StructureFromMotion_1.output}"
            }
        },
        "SfMTransfer_2": {
            "nodeType": "SfMTransfer",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{SfMFilter_2.outputSfMData_selected}",
                "reference": "{StructureFromMotion_1.output}",
                "transferLandmarks": false
            }
        },
        "StructureFromMotion_1": {
            "nodeType": "StructureFromMotion",
            "position": [
                0,
                0
            ],
            "inputs": {
                "input": "{FeatureMatching_1.input}",
                "featuresFolders": "{FeatureMatching_1.featuresFolders}",
                "matchesFolders": [
                    "{FeatureMatching_1.output}"
                ],
                "describerTypes": [
                    "dspsift",
                    "tag16h5"
                ]
            }
        }
    }
}